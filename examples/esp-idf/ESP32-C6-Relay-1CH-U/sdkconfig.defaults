CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_IDF_TARGET="esp32c6"
CONFIG_RELAY_DEMO_AP_SSID="ESP32-C6-Relay-1CH-U"
CONFIG_RELAY_DEMO_AP_PASSWORD="waveshare"
CONFIG_RELAY_DEMO_MODE_WIFI_AP=y
# CONFIG_RELAY_DEMO_MODE_WIFI_STA is not set
